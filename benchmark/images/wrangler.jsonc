// The benchmark's image server (worker.ts) and its images (out/, made by
// make-images.ts), on workers.dev.
{
    "name": "react-native-fast-image-benchmark",
    "main": "worker.ts",
    "compatibility_date": "2026-09-01",
    "workers_dev": true,
    "assets": {
        "directory": "out",
        "binding": "ASSETS",
        "run_worker_first": true,
    },
}
