{
    // Bun scripts, with the Bun types from ../images.
    "compilerOptions": {
        "target": "ES2024",
        "lib": ["ES2024"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "typeRoots": ["../images/node_modules/@types"],
        "types": ["bun"]
    },
    "files": ["run.ts", "analyze.ts", "summarize.ts"]
}
