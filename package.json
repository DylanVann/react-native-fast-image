{
    "name": "react-native-fast-image",
    "version": "8.29.0",
    "description": "FastImage, performant React Native image component.",
    "keywords": [
        "cache",
        "cached",
        "fastimage",
        "image",
        "priority"
    ],
    "homepage": "https://github.com/DylanVann/react-native-fast-image#readme",
    "bugs": {
        "url": "https://github.com/DylanVann/react-native-fast-image/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DylanVann/react-native-fast-image.git"
    },
    "license": "(MIT AND Apache-2.0)",
    "author": "Dylan Vann <dylan@dylanvann.com> (https://dylanvann.com)",
    "main": "dist/index.cjs",
    "module": "dist/index",
    "react-native": "dist/index.cjs",
    "browser": "dist/index.web.js",
    "typings": "dist/index.d.ts",
    "files": [
        "android/build.gradle",
        "android/consumer-rules.pro",
        "android/src/main",
        "android/src/glide-4.15",
        "android/src/glide-older",
        "ios/FastImage",
        "ios/FastImage.xcodeproj/project.pbxproj",
        "ios/FastImage.xcodeproj/xcshareddata",
        "app.plugin.js",
        "dist",
        "RNFastImage.podspec"
    ],
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.build.json && perl -0pi -e 's/\\n\\s*\\* \\@privateRemarks.*?(?=\\n\\s*\\*\\/)//gs' dist/index.d.ts dist/index.web.d.ts && rolldown -c && for f in index index.cjs index.web index.cjs.web; do cp src/index.js.flow dist/$f.js.flow; done",
        "lint": "oxlint",
        "release": "semantic-release",
        "test": "bun test",
        "typecheck": "tsc -p tsconfig.json",
        "format": "oxfmt",
        "format:check": "oxfmt --check"
    },
    "packageManager": "bun@1.4.2",
    "resolutions": {
        "@types/react": "^17.0.14"
    },
    "devDependencies": {
        "@semantic-release/changelog": "7.0.0",
        "@semantic-release/git": "11.0.1",
        "@types/bun": "^1.4.2",
        "@types/react": "^17.0.14",
        "@types/react-native": "^0.69.5",
        "@types/react-test-renderer": "^17.0.1",
        "conventional-changelog-angular": "8.3.1",
        "maestro-runner": "1.1.27",
        "odiff-bin": "^4.5.0",
        "oxfmt": "0.70.0",
        "oxlint": "1.85.0",
        "pretty-format": "^30.5.1",
        "react": "17.0.2",
        "react-test-renderer": "17.0.2",
        "rolldown": "1.2.11",
        "semantic-release": "25.0.9",
        "typescript": "7.0.2"
    },
    "peerDependencies": {
        "react": "^17 || ^18 || ^19",
        "react-native": ">=0.60.0"
    }
}
