{
    "name": "react-native-fast-image",
    "version": "8.6.33",
    "description": "🚩 FastImage, performant React Native image component.",
    "keywords": [
        "cache",
        "cached",
        "fastimage",
        "image",
        "priority"
    ],
    "homepage": "https://github.com/DylanVann/react-native-fast-image#readme",
    "bugs": {
        "url": "https://github.com/DylanVann/react-native-fast-image/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DylanVann/react-native-fast-image.git"
    },
    "license": "(MIT AND Apache-2.0)",
    "author": "Dylan Vann <dylan@dylanvann.com> (https://dylanvann.com)",
    "main": "dist/index.cjs.js",
    "module": "dist/index.js",
    "typings": "dist/index.d.ts",
    "react-native": "src/index.tsx",
    "files": [
        "android/build.gradle",
        "android/src/main",
        "ios/FastImage",
        "dist",
        "src",
        "!src/**/*.test.*",
        "!src/__snapshots__",
        "RNFastImage.podspec"
    ],
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.build.json && rolldown -c",
        "lint": "oxlint",
        "release": "semantic-release",
        "test": "bun test",
        "typecheck": "tsc -p tsconfig.json",
        "format": "oxfmt",
        "format:check": "oxfmt --check"
    },
    "packageManager": "bun@1.4.2",
    "resolutions": {
        "@types/react": "^19.2.0"
    },
    "devDependencies": {
        "@semantic-release/changelog": "7.0.0",
        "@semantic-release/git": "11.0.1",
        "@types/bun": "^1.4.2",
        "@types/react": "^19.2.0",
        "@types/react-test-renderer": "^17.0.1",
        "maestro-runner": "1.1.27",
        "oxfmt": "0.70.0",
        "oxlint": "1.85.0",
        "pretty-format": "^30.5.1",
        "react": "17.0.2",
        "react-native": "0.87.1",
        "react-test-renderer": "17.0.2",
        "rolldown": "1.2.11",
        "semantic-release": "25.0.9",
        "typescript": "7.0.2"
    },
    "peerDependencies": {
        "react": "*",
        "react-native": ">=0.76.0"
    },
    "codegenConfig": {
        "name": "RNFastImageSpec",
        "type": "all",
        "jsSrcsDir": "src",
        "android": {
            "javaPackageName": "com.dylanvann.fastimage"
        },
        "ios": {
            "componentProvider": {
                "FastImageView": "FFFastImageViewComponentView"
            },
            "modulesProvider": {
                "FastImageModule": "FFFastImageModule"
            }
        }
    }
}
