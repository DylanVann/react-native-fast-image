{
    "$schema": "https://nitro.margelo.com/nitro.schema.json",
    "cxxNamespace": ["fastimage", "nitroimage"],
    "ios": {
        "iosModuleName": "FastImageNitroImage"
    },
    "android": {
        "androidNamespace": ["fastimage", "nitroimage"],
        "androidCxxLibName": "FastImageNitroImage"
    },
    "autolinking": {
        "FastImageNitroImages": {
            "ios": {
                "language": "swift",
                "implementationClassName": "HybridFastImageNitroImages"
            },
            "android": {
                "language": "kotlin",
                "implementationClassName": "HybridFastImageNitroImages"
            }
        }
    },
    "ignorePaths": ["**/node_modules", "lib"]
}
