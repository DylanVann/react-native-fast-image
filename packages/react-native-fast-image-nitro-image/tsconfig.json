{
    "compilerOptions": {
        "target": "ES2019",
        "module": "ESNext",
        "lib": ["ESNext"],
        "moduleResolution": "Bundler",
        "strict": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "declaration": true,
        "rootDir": "src",
        "outDir": "lib",
        "types": []
    },
    "include": ["src"]
}
