{
    "scenarios": [
        {
            "name": "fade",
            "steps": [
                {
                    "hold": "/cyan.png"
                },
                {
                    "view": "image",
                    "size": [48, 48],
                    "url": "/cyan.png",
                    "transition": {
                        "duration": 1000
                    }
                },
                {
                    "expect": {
                        "colors": {
                            "image": "#000000"
                        }
                    }
                },
                {
                    "release": "/cyan.png"
                },
                {
                    "waitFor": {
                        "loaded": ["image"]
                    }
                },
                {
                    "fade": "image",
                    "duration": 1000,
                    "expect": ["#000000", "#008080", "#00ffff"]
                }
            ]
        },
