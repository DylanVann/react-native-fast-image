{
    "name": "fast-image-website",
    "private": true,
    "type": "module",
    "devDependencies": {
        "@phosphor-icons/core": "2",
        "github-slugger": "2",
        "typedoc": "0.28",
        "typedoc-plugin-markdown": "4",
        "typescript": "6",
        "wrangler": "4"
    },
    "dependencies": {
        "@astrojs/starlight": "^0.42.5",
        "@fontsource-variable/geist": "^5.3.0",
        "@fontsource-variable/geist-mono": "^5.3.0",
        "astro": "^7.3.5"
    },
    "scripts": {
        "generate": "node scripts/generate.mts",
        "check": "node scripts/generate.mts --check",
        "dev": "node scripts/generate.mts && astro dev",
        "build": "node scripts/generate.mts && astro build",
        "preview": "astro preview",
        "deploy": "bun run build && wrangler deploy"
    }
