---
// Starlight's page sidebar without "On this page" for narrower screens, which
// TwoColumnContent puts at the top of the content instead.
import TableOfContents from 'virtual:starlight/components/TableOfContents'
---

{
    Astro.locals.starlightRoute.toc && (
        <div class="right-sidebar-panel sl-hidden lg:sl-block">
            <div class="sl-container">
                <TableOfContents />
            </div>
        </div>
    )
}

<script>
    // The table of contents can be longer than the window. When the current
    // section (which Starlight marks with aria-current) goes out of its view,
    // scroll it, not the page, to show it a third of the way down. Not while
    // the pointer is over it, so it doesn't move while it's being read or
    // scrolled.
    const toc = document.querySelector('.right-sidebar-panel starlight-toc')
    const scroller = toc?.closest('.right-sidebar')
    if (toc && scroller) {
        new MutationObserver(() => {
            const current = toc.querySelector('a[aria-current="true"]')
            if (!current || scroller.matches(':hover')) return
            const box = scroller.getBoundingClientRect()
            // The column starts under the header.
            const top = box.top + parseFloat(getComputedStyle(scroller).paddingTop)
            const link = current.getBoundingClientRect()
            const margin = 32
            if (link.top < top + margin || link.bottom > box.bottom - margin)
                scroller.scrollBy({
                    top: link.top - top - (box.bottom - top) / 3,
                    behavior: 'smooth',
                })
        }).observe(toc, { subtree: true, attributeFilter: ['aria-current'] })
    }
</script>

<style>
    /* In Starlight's layer, like its own, so the table of contents' styles
       (e.g. the current section's color) still win over these. */
    @layer starlight.core {
        .right-sidebar-panel {
            padding: 2.5rem var(--sl-sidebar-pad-x) 1rem;
        }
        .sl-container {
            width: calc(var(--sl-sidebar-width) - 2 * var(--sl-sidebar-pad-x));
        }
        .right-sidebar-panel :global(h2) {
            color: var(--sl-color-white);
            font-size: var(--sl-text-h5);
            font-weight: 600;
            line-height: var(--sl-line-height-headings);
            margin-bottom: 0.5rem;
        }
        .right-sidebar-panel :global(:where(a)) {
            display: block;
            font-size: var(--sl-text-xs);
            text-decoration: none;
            color: var(--sl-color-gray-3);
            overflow-wrap: anywhere;
        }
        .right-sidebar-panel :global(:where(a):hover) {
            color: var(--sl-color-white);
        }
    }
</style>
